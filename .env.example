# Server-side AI gateway secret. Never use a VITE_ prefix for this key.
LOVABLE_API_KEY=replace-with-your-server-side-key

# Supabase browser configuration (public/publishable key only).
# Use either VITE_SUPABASE_PUBLISHABLE_KEY or the legacy VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
